set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY SCU
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY out_new
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name AUTO_ROM_RECOGNITION ON
source area_profile.qsf
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/Saturn/SCU/SCU_PKG.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/Saturn/SCU/DSP_PKG.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/Saturn/SCU/RAM.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/Saturn/SCU/DSP.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/Saturn/SCU/SCU.sv
set_instance_assignment -name VIRTUAL_PIN ON -to *
