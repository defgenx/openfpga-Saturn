# sh1_pruned: SH-1 (SH7034 + SH1_MEM) standalone map project, 5CEBA4F23C8, area profile.
# Run from this directory: quartus_map sh1_pruned
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY SH1
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_sh1_pruned
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name AUTO_ROM_RECOGNITION ON
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
source area_profile.qsf
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/core/SH_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/core/SH_regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/core/SH_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/core/SH_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/SH7034_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/MULT.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/INTC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/BSC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/DMAC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/UBC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/ITU.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/WDT.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/SCI.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/PFC.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/RAM.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/ROM.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/SH/SH7034/SH7034.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/fpga/saturn/Saturn/CD/SH1.sv
set_parameter -name rom_file "../../ref/Saturn_MiSTer/rtl/cdb105m.mif"
set_instance_assignment -name VIRTUAL_PIN ON -to *
