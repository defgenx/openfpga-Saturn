# System PLL (74.25 MHz reference, fractional, runtime reconfigurable) and its reconfiguration block.
# Regenerate with tools/gen_pll_sys.sh.
set_global_assignment -name SYNTHESIS_ONLY_QIP ON
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll_sys.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll_sys_cfg.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) altera_pll_reconfig_top.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) altera_pll_reconfig_core.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) altera_std_synchronizer.v]
set_instance_assignment -name PLL_COMPENSATION_MODE NORMAL -to "*pll_sys*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name UNFORCE_MERGE_PLL_OUTPUT_COUNTER ON -to "*pll_sys*|altera_pll:altera_pll_i*|*"
